cabal-version:      3.0
name:               venato
version:            0.1.0.0
synopsis:           A day-based todo list for the terminal
license:            GPL-3.0-only
license-file:       LICENSE
build-type:         Simple

executable venato
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base, directory, filepath, time
    default-language: Haskell2010
    ghc-options:      -Wall
